{
  "name": "agentic-design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.components.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run --config vitest.config.ts",
    "token-lint": "tsx checks/token-lint/index.ts",
    "baseline-metrics": "tsx checks/baseline-metrics/index.ts",
    "build": "npm run build --workspaces --if-present",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "icons:build": "tsx scripts/build-icons.ts",
    "a11y": "tsx scripts/a11y.ts",
    "figma:sync": "tsx scripts/figma-sync.ts",
    "parity": "tsx checks/parity/index.ts",
    "prestorybook": "npm run tokens:build",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run tokens:build",
    "build-storybook": "storybook build",
    "generate": "tsx scripts/generate.ts",
    "fixtures:demo": "tsx scripts/record-fixture.ts evals/fixtures/demo/sign-in.spec.json evals/fixtures/demo/sign-in.screen.tsx \"A sign-in card with email and password inputs, a remember-me checkbox and a primary sign-in button\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource/saira": "^5.3.0",
    "@fontsource/saira-semi-condensed": "^5.3.0",
    "@internationalized/date": "3.12.4",
    "js-yaml": "^5.5.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@material-symbols/svg-600": "0.48.2",
    "@playwright/test": "^1.56.1",
    "@storybook/react-vite": "10.6.7",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "jsdom": "31.0.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "storybook": "10.6.7",
    "storybook-addon-pseudo-states": "10.6.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "8.3.8",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
